---
import type { WorkProject } from '../data/portfolio';
import SmtProjectVisual from './SmtProjectVisual.astro';
import BroadcastMedia from './BroadcastMedia.astro';
import SoccerHeatmap from './SoccerHeatmap.astro';
import NascarTelemetry from './NascarTelemetry.astro';
import SketchRecognition from './SketchRecognition.astro';
import QuantumProjectVisual from './QuantumProjectVisual.astro';
interface Props {
  project: WorkProject;
  nested?: boolean;
  concise?: boolean;
}
const { project, nested = false, concise = false } = Astro.props;
const Heading = nested ? 'h3' : 'h2';
const DetailHeading = nested ? 'h4' : 'h3';
const illustrated =
  concise && !!(project.visual || project.media || project.quantumVisual);
---

<section
  class:list={['project-story', { 'article-story': concise }]}
  id={project.id}
>
  <div class:list={['story-layout', { illustrated }]}>
    <div class="story-copy">
      <Heading class="project-title">{project.title}</Heading>
      <p class="project-summary">{project.summary}</p>
      {concise ? (
        <div class="story-prose">
          <p>{project.approach}</p>
          <p class="story-result">{project.outcome}</p>
        </div>
      ) : (
        <dl>
          <dt>The problem</dt>
          <dd>{project.challenge}</dd>
          <dt>{project.contributionLabel ?? 'What I built'}</dt>
          <dd>{project.approach}</dd>
          <dt>The result</dt>
          <dd>{project.outcome}</dd>
        </dl>
      )}
      <ul class="skill-tags">
        {project.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
      {(project.details || (concise && !project.quantumVisual)) && (
        <details class="project-depth">
          <summary>Inside the engineering</summary>
          <div>
            {concise && (
              <section>
                <DetailHeading>The challenge</DetailHeading>
                <p>{project.challenge}</p>
              </section>
            )}
            {project.details?.map((detail) => (
              <section>
                <DetailHeading>{detail.title}</DetailHeading>
                <p>{detail.body}</p>
              </section>
            ))}
            {project.context && (
              <aside class="project-context">
                <p class="kicker">COMPANY CONTEXT / SMT</p>
                <DetailHeading>{project.context.title}</DetailHeading>
                <p>{project.context.body}</p>
                <p>{project.context.scope}</p>
              </aside>
            )}
          </div>
        </details>
      )}
      {project.context && (
        <a
          class="text-link context-link"
          href={project.context.source.href}
          target="_blank"
          rel="noopener"
        >
          {project.context.source.label} ↗
        </a>
      )}
      {project.link && (
        <a
          class="text-link"
          href={project.link.href}
          target="_blank"
          rel="noopener"
        >
          {project.link.label} ↗
        </a>
      )}
    </div>
    {(project.visual || project.media || project.quantumVisual) && (
      <div class="story-visual">
        {project.quantumVisual && (
          <QuantumProjectVisual kind={project.quantumVisual} />
        )}
        {project.media && <BroadcastMedia clips={project.media} />}
        {project.visual === 'soccer' ? (
          <SoccerHeatmap />
        ) : project.visual === 'telemetry' ? (
          <NascarTelemetry />
        ) : project.visual === 'sketch' ? (
          <SketchRecognition />
        ) : (
          project.visual && <SmtProjectVisual kind={project.visual} />
        )}
      </div>
    )}
  </div>
</section>
<style>
  .illustrated {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.06fr);
    gap: 34px;
    align-items: start;
  }
  .story-copy,
  .story-visual {
    min-width: 0;
  }
  .story-visual {
    padding-top: 4px;
  }
  .article-story {
    padding: 44px 0;
  }
  .article-story .project-title {
    font-size: 25px;
    line-height: 1.35;
  }
  .article-story .project-summary {
    margin-bottom: 18px;
    font-size: 12px;
    line-height: 1.85;
  }
  .story-prose {
    max-width: 66ch;
  }
  .story-prose p {
    margin: 0 0 18px;
    font-size: 14px;
    line-height: 1.85;
    color: #bcbcc5;
  }
  .story-prose .story-result {
    color: #d0dce1;
  }
  .article-story .skill-tags {
    gap: 6px;
    margin: 22px 0;
  }
  .article-story .project-depth {
    border: 0;
    border-top: 1px solid #30343b;
    background: transparent;
    margin-top: 20px;
  }
  .article-story .project-depth summary {
    padding: 15px 0;
    font-size: 12px;
  }
  .article-story .project-depth > div {
    padding: 0 0 16px;
  }
  .article-story .context-link {
    display: inline-block;
    font-size: 11px;
    line-height: 1.8;
    margin-top: 15px;
  }
  .project-context {
    border-left: 2px solid #e9bb7d;
    padding-left: 18px;
    margin-top: 24px;
  }
  .project-context .kicker {
    color: #e9bb7d;
    font-size: 9px;
    margin-bottom: 12px;
  }
  .project-context p + p {
    margin-top: 14px;
  }
  @media (min-width: 801px) and (max-width: 1100px) {
    .illustrated {
      grid-template-columns: 1fr;
      gap: 22px;
    }
    .story-visual {
      max-width: 480px;
    }
  }
  @media (max-width: 650px) {
    .illustrated {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .story-visual {
      max-width: 480px;
    }
    .article-story .project-title {
      font-size: 23px;
    }
  }
</style>
