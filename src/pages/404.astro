---
import Layout from '../layouts/PortfolioLayout.astro';
---

<Layout
  title="Page not found — Riccardo Salzmann"
  description="This page could not be found. Return to Riccardo’s workbench or explore the portfolio."
>
  <section class="content-shell">
    <p class="kicker">PATH NOT FOUND</p>
    <div class="error-code" aria-hidden="true">
      404_
    </div>
    <h1>This page isn’t on the desk.</h1>
    <p class="lede">
      The link may have moved, or the address may be incomplete. There’s still
      plenty to explore.
    </p>
    <div class="action-row">
      <a class="site-button" href="/">
        Back to the desk →
      </a>
      <a class="site-button secondary" href="/work/">
        Browse the work →
      </a>
      <a class="site-button secondary" href="/journal/">
        Open the journal →
      </a>
    </div>
  </section>
</Layout>
